    resultMessage: Ate Grace hands you a small sealed box. "Keep it cool. Use it only if you must."
    contactFlag: 
    contactMessage: 
    pagpagFood: 0
    instantCure: 1
    speaker: Ate Grace (pharmacist)
    playerLine: I need the strongest thing you have. The one that works right away.
    npcLines:
